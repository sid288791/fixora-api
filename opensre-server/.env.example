# opensre-server environment template.
# Copy to .env and fill in a real key. Never commit .env itself (gitignored).

# --- LLM provider ---
# Groq is NOT a natively supported provider name in OpenSRE 2026.4.5 (pinned in
# requirements.txt) — only: anthropic, openai, openrouter, gemini, nvidia, ollama,
# bedrock, minimax — and the "openai" provider has no base_url override. The "ollama"
# provider builds its client generically as OpenAI(api_key=OLLAMA_API_KEY,
# base_url=f"{OLLAMA_HOST}/v1") — exactly the OpenAI-compatible shape Groq exposes.
# Reusing that code path to point at Groq instead of a local Ollama server.
# Unofficial/unsupported by OpenSRE, but verified working — see README.md.
#
# Note: a newer/unpinned OpenSRE (upstream `main`) has since added native Groq
# support (GROQ_API_KEY/GROQ_MODEL/...) — worth switching to once that's on PyPI,
# see docs/idea.md item #0 in the main fixora-api repo.
LLM_PROVIDER=ollama
OLLAMA_HOST=https://api.groq.com/openai
OLLAMA_MODEL=openai/gpt-oss-120b
OLLAMA_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY

# Alternative providers (uncomment if used instead)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# --- Telemetry (disable outbound analytics for local/dev use) ---
OPENSRE_NO_TELEMETRY=1
